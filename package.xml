<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>geodex_nav2_planner</name>
  <version>1.0.0</version>
  <description>
    Nav2 global planner that plans on SE(2) as a Riemannian manifold with geodex.
    It searches with G-RRT* under a left-invariant metric with a clearance factor
    over an exact distance transform of the costmap, smooths on the same metric, and
    publishes every smoothed waypoint with each edge split into equal steps. The
    metric weights select differential-drive or holonomic behavior.
  </description>
  <maintainer email="phone.thiha@robotics.utias.utoronto.ca">Phone Thiha Kyaw</maintainer>
  <license>Apache-2.0</license>
  <url type="repository">https://github.com/utiasSTARS/geodex_nav2_planner</url>
  <url type="bugtracker">https://github.com/utiasSTARS/geodex_nav2_planner/issues</url>
  <author email="phone.thiha@robotics.utias.utoronto.ca">Phone Thiha Kyaw</author>
  <author email="ghanta1996@gmail.com">Sriharsha Ghanta</author>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>python3-yaml</buildtool_depend>

  <!-- geodex is not a rosdep key. scripts/build_deps.sh installs it with the OMPL
       fork it pins, and the plugin links that fork statically. The package does not
       depend on the stock ompl key. -->
  <depend>geodex</depend>
  <depend>boost</depend>
  <depend>generate_parameter_library</depend>
  <depend>geometry_msgs</depend>
  <build_depend condition="$ROS_DISTRO == lyrical">nav2_common</build_depend>
  <depend>nav2_core</depend>
  <depend>nav2_costmap_2d</depend>
  <depend condition="$ROS_DISTRO == lyrical">nav2_ros_common</depend>
  <depend>nav_msgs</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>visualization_msgs</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>lifecycle_msgs</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>
  <exec_depend>nav2_map_server</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>nav2_planner</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <test_depend>action_msgs</test_depend>
  <test_depend>ament_cmake_clang_format</test_depend>
  <test_depend>ament_cmake_cppcheck</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_cmake_ros</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>launch_testing</test_depend>
  <test_depend>launch_testing_ament_cmake</test_depend>
  <test_depend condition="$ROS_DISTRO == lyrical">rmw_test_fixture_implementation</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
